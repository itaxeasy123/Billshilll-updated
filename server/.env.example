# Production: a real PostgreSQL DSN, e.g. postgresql+asyncpg://user:pass@host:5432/ledgerprime
# Local dev/tests in an environment without Docker/Postgres available: SQLite works via the same
# SQLAlchemy async engine (aiosqlite) - see app/infrastructure/database/base.py.
DATABASE_URL=postgresql+asyncpg://ledgerprime:ledgerprime@localhost:5432/ledgerprime

# Never commit a real secret here - this file is the template. Generate with `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-in-a-real-deployment
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
